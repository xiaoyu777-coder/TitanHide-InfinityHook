#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
DLG_OPTIONS DIALOG 0, 0, 296, 190
STYLE DS_3DLOOK | DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_CAPTION | WS_VISIBLE | WS_POPUP | WS_SYSMENU
CAPTION "TitanHide Options"
FONT 8, "Courier New"
{
    LTEXT           "Driver: unknown", IDC_TXT_DRIVER_STATUS, 7, 7, 214, 8, 0, WS_EX_LEFT
    PUSHBUTTON      "&Refresh", IDC_BTN_REFRESH_DRIVER, 232, 17, 57, 14, 0, WS_EX_LEFT
    LTEXT           "TitanHideName:", IDC_STATIC, 7, 19, 58, 8, 0, WS_EX_LEFT
    EDITTEXT        IDC_EDT_DRIVER_NAME, 68, 17, 158, 13, ES_AUTOHSCROLL, WS_EX_LEFT
    GROUPBOX        "Options", IDC_STATIC, 2, 34, 287, 123, 0, WS_EX_LEFT
    AUTOCHECKBOX    "ProcessDebugFlags (NtQuery/NtSetProcess)", IDC_CHK_PROCESSDEBUGFLAGS, 7, 44, 246, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "ProcessDebugPort", IDC_CHK_PROCESSDEBUGPORT, 7, 54, 120, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "ProcessDebugObjectHandle", IDC_CHK_PROCESSDEBUGOBJECTHANDLE, 7, 64, 180, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "DebugObject", IDC_CHK_DEBUGOBJECT, 7, 74, 90, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "SystemDebuggerInformation", IDC_CHK_SYSTEMDEBUGGERINFORMATION, 7, 84, 170, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "NtClose", IDC_CHK_NTCLOSE, 7, 94, 70, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "ThreadHideFromDebugger (Nt/ZwSetThread)", IDC_CHK_THREADHIDEFROMDEBUGGER, 7, 104, 246, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "GetContextThread", IDC_CHK_NTGETCONTEXTTHREAD, 7, 114, 120, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "SetContextThread", IDC_CHK_NTSETCONTEXTTHREAD, 7, 124, 120, 8, 0, WS_EX_LEFT
    AUTOCHECKBOX    "SystemDebugControl", IDC_CHK_NTSYSTEMDEBUGCONTROL, 7, 134, 130, 8, 0, WS_EX_LEFT
    LTEXT           "TitanHideOptions (0xFFFFFFFF)", IDC_TXT_OPTIONS_TIP, 7, 146, 160, 8, 0, WS_EX_LEFT
    PUSHBUTTON      "Select &All", IDC_BTN_SELECTALL, 7, 163, 57, 14, 0, WS_EX_LEFT
    PUSHBUTTON      "Select &None", IDC_BTN_SELECTNONE, 69, 163, 57, 14, 0, WS_EX_LEFT
    PUSHBUTTON      "All but T&hread", IDC_BTN_SELECT_SAFE, 131, 163, 67, 14, 0, WS_EX_LEFT
    DEFPUSHBUTTON   "OK", IDOK, 205, 163, 40, 14, 0, WS_EX_LEFT
    PUSHBUTTON      "Cancel", IDCANCEL, 249, 163, 40, 14, 0, WS_EX_LEFT
}
